{
  "name": "saas-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "description": "SaaS Platform 多租户多组织权限平台 (Rust + PostgreSQL + Vite + React)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs --apps host,vue,jquery,websocket,work-orders,stores",
    "dev:frontend": "node scripts/dev.mjs --apps host",
    "dev:vue": "npm --prefix mini-services/micro-vue run dev",
    "dev:jquery": "npm --prefix mini-services/micro-jquery run dev",
    "dev:websocket": "npm --prefix examples/websocket run dev",
    "dev:work-orders": "node scripts/dev.mjs --apps work-orders",
    "dev:work-orders:backend": "cargo run --locked --manifest-path business-apps/work-orders/backend/Cargo.toml",
    "dev:stores": "node scripts/dev.mjs --apps stores",
    "dev:stores:backend": "cargo run --locked --manifest-path business-apps/stores/backend/Cargo.toml",
    "dev:chat:backend": "cargo run --locked --manifest-path examples/websocket/backend/Cargo.toml --target-dir target/phase22-chat",
    "dev:oauth": "node scripts/dev.mjs --apps none --with-oauth",
    "dev:backend": "cd backend && cargo run --locked",
    "db:push": "echo '[saas-platform] 数据库由 Rust 后端 SQLx 迁移自动管理 (PostgreSQL)'",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:contracts": "npm --prefix frontend run test:contracts",
    "test:realtime": "node --test --test-concurrency=1 tests/phase22-socketio.mjs",
    "sdk:sync": "node scripts/sync-micro-sdk.mjs",
    "sdk:check": "node scripts/sync-micro-sdk.mjs --check",
    "test:sdk": "node --test tests/micro-sdk-generation.mjs tests/micro-sdk-client.mjs tests/micro-iframe-protocol.mjs",
    "check:rust": "cargo check --locked --manifest-path backend/Cargo.toml --all-targets",
    "test:rust": "cargo test --locked --manifest-path backend/Cargo.toml --bin saas-platform-backend",
    "fmt:rust": "cargo fmt --manifest-path backend/Cargo.toml --all -- --check",
    "clippy:rust": "cargo clippy --locked --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "doc:rust": "cargo doc --locked --manifest-path backend/Cargo.toml --no-deps",
    "build:stores": "cargo build --locked --manifest-path business-apps/stores/backend/Cargo.toml --bin stores-api",
    "check:stores": "cargo check --locked --manifest-path business-apps/stores/backend/Cargo.toml --all-targets --all-features",
    "test:stores": "cargo test --locked --manifest-path business-apps/stores/backend/Cargo.toml --lib --all-features",
    "fmt:stores": "cargo fmt --manifest-path business-apps/stores/backend/Cargo.toml --all -- --check",
    "clippy:stores": "cargo clippy --locked --manifest-path business-apps/stores/backend/Cargo.toml --all-targets --all-features -- -D warnings",
    "doc:stores": "cargo doc --locked --manifest-path business-apps/stores/backend/Cargo.toml --no-deps --all-features",
    "build": "npm --prefix frontend run build",
    "build:work-orders": "npm --prefix business-apps/work-orders/frontend run build",
    "build:stores:frontend": "npm --prefix business-apps/stores/frontend run build",
    "test:stores:frontend": "npm --prefix business-apps/stores/frontend test",
    "build:examples": "npm --prefix mini-services/micro-vue run build && npm --prefix mini-services/micro-jquery run build && npm --prefix examples/websocket run build && npm --prefix mini-services/oauth-playground/frontend run build && npm run build:work-orders && npm run build:stores:frontend",
    "build:all": "npm run build:examples && npm run micro:sync:examples && npm run build",
    "test:dev": "node --test tests/dev-runner.mjs tests/dev-vite-integration.mjs",
    "test:vite": "node --test tests/vite-host-static.mjs tests/vite-example-delivery.mjs",
    "micro:sync": "node scripts/sync-microapp.mjs",
    "micro:sync:examples": "node scripts/sync-microapp.mjs vue mini-services/micro-vue/dist && node scripts/sync-microapp.mjs jquery mini-services/micro-jquery/dist",
    "check:platform-admin": "cargo check --locked --manifest-path tools/platform-admin/Cargo.toml --all-targets --all-features",
    "test:platform-admin": "cargo test --locked --manifest-path tools/platform-admin/Cargo.toml --all-targets --all-features",
    "test:managed-deployment": "node scripts/ci/managed-deployment.mjs"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.4"
  }
}
