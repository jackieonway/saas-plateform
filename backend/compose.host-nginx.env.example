# Host Nginx deployment. Copy to an operator-owned private env file.
PUBLIC_APP_URL=https://saas.example.com
EDGE_NETWORK_NAME=platform-edge
# Verify the actual API socket peer; commonly the selected Docker bridge gateway.
HOST_NGINX_PROXY_IP=
HOST_BACKEND_PORT=13001
HOST_FRONTEND_PORT=18080
HOST_NOTIFICATION_PORT=13003

# Approved immutable registry/repository@sha256:... image references.
POSTGRES_IMAGE=
PLATFORM_IMAGE=
FRONTEND_IMAGE=
POSTGRES_USER=platform
POSTGRES_DB=saas_platform
POSTGRES_PASSWORD=
PLATFORM_DATABASE_URL=
JWT_SECRET=
PLATFORM_METRICS_TOKEN=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
DATA_GRANT_POLICY='{"applications":[],"managementScopes":[]}'

# Independent SSO authority, distinct service credentials and PLATFORM_CONSOLE RP.
IDENTITY_ISSUER=https://auth.example.invalid
IDENTITY_SERVICE_URL=https://identity.internal.example.invalid
IDENTITY_SERVICE_CLIENT_ID=
IDENTITY_SERVICE_CLIENT_SECRET=
IDENTITY_KEY_ADMIN_SERVICE_CLIENT_ID=
IDENTITY_KEY_ADMIN_SERVICE_CLIENT_SECRET=
IDENTITY_PROJECTION_SERVICE_CLIENT_ID=
IDENTITY_PROJECTION_SERVICE_CLIENT_SECRET=
IDENTITY_AUTH_ADMIN_SERVICE_CLIENT_ID=
IDENTITY_AUTH_ADMIN_SERVICE_CLIENT_SECRET=
# Separate AUTH_REVIEW and AUTH_INVITATION service registrations; unset is closed.
IDENTITY_REVIEW_SERVICE_CLIENT_ID=
IDENTITY_REVIEW_SERVICE_CLIENT_SECRET=
IDENTITY_INVITATION_SERVICE_CLIENT_ID=
IDENTITY_INVITATION_SERVICE_CLIENT_SECRET=
CONTEXT_SOURCE_SERVICE_CLIENT_ID=
CONTEXT_SOURCE_SERVICE_CLIENT_SECRET=
# Independent RESOURCE_ACCESS_PROOF identity service, scoped to canonical resource UUIDs.
RESOURCE_PROOF_SERVICE_CLIENT_ID=
RESOURCE_PROOF_SERVICE_CLIENT_SECRET=
IDENTITY_CA_FILE=/srv/platform/secrets/identity-ca.pem
BFF_OIDC_CLIENT_ID=
BFF_OIDC_CLIENT_SECRET=
BFF_TOKEN_KEY_FILE=/srv/platform/secrets/bff-token-keys.json

# Private resource service authentication and request budgets.
RESOURCE_SERVICE_REQUESTS_PER_MINUTE=600
RESOURCE_SERVICE_AUTH_FAILURES_PER_MINUTE=30
RESOURCE_SERVICE_ATTEMPTS_PER_MINUTE=1000
