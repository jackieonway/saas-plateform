# 仅测试配置模板；复制到已忽略的 .env.test 后明确填写本次自有环境。
# 数据库用例创建并清理各自带 UUIDv7 的临时库，不迁移已有业务库。
# TEST_DATABASE_URL 必须指向本次回环 PostgreSQL 的 postgres 管理库。
# 不使用线上账号；这里的端口和占位凭据不表示已有环境已获授权。
TEST_DATABASE_URL=postgres://test_admin:replace_me@127.0.0.1:55494/postgres

# 显式阶段 fixture 不读取通用 .env 或依赖其他阶段残留数据。
# 按所运行测试模块设置对应变量；需要指纹的用例还核对实际集群 ID。
# 以下只作配置格式，不可直接对任意数据库重放：
# IDENTITY_PHASE12_TEST_DATABASE_URL=<same owned loopback postgres admin URL>
# IDENTITY_PHASE12_TEST_CLUSTER_ID=<SELECT system_identifier FROM pg_control_system()>
# IDENTITY_PHASE24_TEST_DATABASE_URL=<same owned loopback postgres admin URL>
# IDENTITY_PHASE24_TEST_CLUSTER_ID=<same exact current cluster identifier>
# IDENTITY_PHASE12_TLS_TESTS=TASK_OWNED
# PHASE25_CLI_BIN=/absolute/task-owned/path/to/current-platform-admin

# 服务端 data-grant 能力和管理范围；空列表拒绝，测试自行显式准备业务权限。
DATA_GRANT_POLICY='{"applications":[],"managementScopes":[]}'

# 平台只做远程 canonical identity 的 RP，不提供本地密码或 OAuth issuer。
# 真实启动还需精确 issuer、独立服务登记、实际 CA 和回调；不借用测试假身份。
# IDENTITY_REMOTE_ENABLED=true
# OIDC_ISSUER=https://auth.example.invalid
# IDENTITY_SERVICE_URL=https://identity.internal.example.invalid
# IDENTITY_SERVICE_CA_FILE=/absolute/private/path/development-ca.pem
# IDENTITY_SERVICE_CLIENT_ID=<ACCOUNT_COMMAND service UUIDv7>
# IDENTITY_SERVICE_CLIENT_SECRET=<independent server-only opaque secret>
# CONTEXT_SOURCE_SERVICE_CLIENT_ID=<CONTEXT_SELECTION_SOURCE service UUIDv7>
# CONTEXT_SOURCE_SERVICE_CLIENT_SECRET=<independent server-only opaque secret>
# IDENTITY_KEY_ADMIN_SERVICE_CLIENT_ID=<KEY_ADMIN service UUIDv7>
# IDENTITY_KEY_ADMIN_SERVICE_CLIENT_SECRET=<independent server-only opaque secret>
# RESOURCE_PROOF_SERVICE_CLIENT_ID=<RESOURCE_ACCESS_PROOF service UUIDv7>
# RESOURCE_PROOF_SERVICE_CLIENT_SECRET=<independent server-only opaque secret>
# PUBLIC_APP_URL=https://console.example.invalid
# BFF_OIDC_ISSUER=https://auth.example.invalid
# BFF_OIDC_CLIENT_ID=<registered confidential USER platform RP UUIDv7>
# BFF_OIDC_CLIENT_SECRET=<independent server-only opaque RP secret>
# BFF_OIDC_REDIRECT_URI=https://console.example.invalid/auth/callback
# BFF_CA_CERT_FILE=/absolute/private/path/development-ca.pem
# BFF_TOKEN_KEY_FILE=/absolute/private/path/bff-token-keys.json
BFF_AUTHORITY_TIMEOUT_MS=3000
BFF_MAX_CONCURRENT=16
BFF_CONTEXT_TTL_SECONDS=300
BFF_CONTEXT_RENEWAL_TTL_SECONDS=604800
BFF_LOGIN_TTL_SECONDS=300

# 独立客户门户 RP、反向 proof 和资料服务须分别登记；未配置保持关闭。
CUSTOMER_PORTAL_PORT_ENABLED=false
# CUSTOMER_PORTAL_OIDC_CLIENT_ID=<registered independent CUSTOMER RP UUIDv7>
# CUSTOMER_PROFILE_CLIENT_REF=<CUSTOMER_PROFILE resource-service UUIDv7>
# CUSTOMER_PROFILE_APPLICATION_ID=<exact customer application UUIDv7>

# 私有资源服务预算，不是公开 OAuth 签发／内省配置。
RESOURCE_SERVICE_REQUESTS_PER_MINUTE=600
RESOURCE_SERVICE_AUTH_FAILURES_PER_MINUTE=30
RESOURCE_SERVICE_ATTEMPTS_PER_MINUTE=1000

# 所有私钥／AEAD keyring／秘密均在仓库外按最小权限提供。
# TLS CA 与 hostname 校验始终开启；禁止向报告输出 token、Cookie 或连接串。
