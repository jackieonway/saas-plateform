# 复制为 .env.test 后填写；.env.test 已被 Git 忽略。
# 必填：隔离 PostgreSQL 测试库。不要填生产数据库。
TEST_DATABASE_URL=postgres://test_user:replace_me@127.0.0.1:5432/saas_platform_test
AUTO_CREATE_DATABASE=true

# 服务端数据 grant 管理策略；默认空列表拒绝。单引号保留 JSON 双引号。
# 需要管理能力的测试须自行显式配置，不复用生产策略或真实 UUID。
DATA_GRANT_POLICY='{"applications":[],"managementScopes":[]}'

# Phase 8 SSO 默认为关闭；隔离测试显式开启并使用自己的 HTTPS origin。
# 此示例不是生产域名配置；浏览器访问还需匹配的 TLS／网关。
SSO_ENABLED=false
# SSO_ORIGIN=https://auth.example.invalid
# PUBLIC_APP_URL=https://console.example.invalid
SSO_SESSION_TTL_SECONDS=43200
SSO_PREAUTH_TTL_SECONDS=300

# Phase 8 ignored 测试仅接受显式 loopback postgres 管理库 URL，
# 使用专有 UUIDv7 名称创建／删除隔离库。不要填实际业务库或生产账号。
# IDENTITY_PHASE08_TEST_DATABASE_URL=postgres://test_admin:replace_me@127.0.0.1:5432/postgres

# Phase 9 OIDC 默认关闭。启用时同时要求 SSO_ENABLED=true，
# OIDC_ISSUER 必须与 SSO_ORIGIN 是同一个精确 HTTPS origin。
# 首次启用后 issuer 固定在该环境数据库中；同库修改 issuer 会拒绝启动。
# 下面只有隔离环境示例，不是已登记的生产域名／客户端。
OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.invalid
# OIDC_KEYSET_PATH=/absolute/private/path/oidc-keyset.json
OIDC_CODE_TTL_SECONDS=120
OIDC_TOKEN_TTL_SECONDS=300
OIDC_REFRESH_TTL_SECONDS=43200
OIDC_INTERACTION_TTL_SECONDS=300
# keyset 必须是绝对路径、只由认证进程读取的外部 JSON 文件，不能提交私钥：
# {"keys":[{"kid":"rsa-a","privateKeyPem":"<externally provisioned RSA PEM>","n":"<canonical base64url public modulus>","e":"AQAB"}]}
# 1..8 个不同 kid；仅 RS256、RSA 2048..4096 位，启动时验证私钥与公钥配对。
# 管理员先 publish kid，再 activate；不会自动创建客户端或签名密钥生命周期。
# 每个 RP 显式注册自己的 confidential USER client、精确 HTTPS callback 和用途。
# 客户端 secret 只交给 RP 服务端，不能写入浏览器资源或本示例。

# Phase 9 ignored 测试同样仅允许显式 loopback postgres 管理库，
# 测试在任务自有独立库中运行，不复用 Phase 6 留存目标或预览资产。
# IDENTITY_PHASE09_TEST_DATABASE_URL=postgres://test_admin:replace_me@127.0.0.1:5432/postgres

# 平台仅支持 SSO／OIDC BFF；实际启动必须提供以下真实配置。
# /auth/config 固定返回 BFF，上游故障不切换认证协议。
CUSTOMER_PORTAL_PORT_ENABLED=false
# Canonical UUIDv7 CUSTOMER_PORTAL RP; distinct from CUSTOMER_PROFILE_CLIENT_REF.
# CUSTOMER_PORTAL_OIDC_CLIENT_ID=
# CUSTOMER_PROFILE_CLIENT_REF=
# CUSTOMER_PROFILE_APPLICATION_ID=
# PUBLIC_APP_URL=https://console.example.invalid
# BFF_OIDC_ISSUER=https://auth.example.invalid
# BFF_OIDC_CLIENT_ID=<actually registered UUIDv7 confidential PLATFORM_CONSOLE client>
# BFF_OIDC_CLIENT_SECRET=<one-time issued opaque client secret; server only>
# BFF_OIDC_REDIRECT_URI=https://console.example.invalid/auth/callback
# BFF_CA_CERT_FILE=/absolute/private/path/development-ca.pem
# BFF_TOKEN_KEY_FILE=/absolute/private/path/bff-token-keys.json
BFF_AUTHORITY_TIMEOUT_MS=3000
BFF_MAX_CONCURRENT=16
BFF_CONTEXT_TTL_SECONDS=300
BFF_LOGIN_TTL_SECONDS=300
# BFF token keyring: {"activeKid":"a","keys":[{"kid":"a","key":"<canonical base64url encoding of 32 random bytes>"}]}
# 只用独立 AES-256-GCM 密钥，不复用 JWT/client secret；旧 kid 保留到其密文退出使用。
# 私钥／AEAD keyring 文件在仓库外按最小权限配置，内容不要提交或写入测试证据。
# TLS 及 hostname 校验始终开启；CA 文件仅增加显式开发信任，不关闭证书校验。
# 平台密码 grant、旧 login/context/logout 及公开平台 refresh 已移除。
# IDENTITY_PHASE10_TEST_DATABASE_URL=postgres://test_admin:replace_me@127.0.0.1:5432/postgres

# 可选：Phase 3 的真实 API 隔离测试；服务和两租户测试账号就绪后填写。
BASELINE_API_URL=http://127.0.0.1:3001
BASELINE_TOKEN_A=
BASELINE_TOKEN_B=
BASELINE_TENANT_A_ID=
BASELINE_TENANT_B_ID=
BASELINE_SHARED_USER_ID=
