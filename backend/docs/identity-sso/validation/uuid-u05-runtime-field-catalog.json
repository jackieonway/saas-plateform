  "notes": [
    "Imported receipt four-field contract is being implemented by inspect_auth; audit has not run it.",
    "Batch UUID inside IMPORT_MARKER comes from U04 receipt, never from an entity remap.",
    "No private env, state JSON or secret values were read for this catalog."
  ],
  "importedReceiptContract": {
    "status": "IMPLEMENTATION_IN_PROGRESS_BY_INSPECT_AUTH_NOT_RUNTIME_VALIDATED",
    "mode": "imported",
    "markerGrammar": "saas-uuid-import/1/<canonical-v7-RFC-batch-uuid>/<64-lowerhex>",
    "schemaSha256": "64 lowerhex from U04 formal schema_material hash",
    "expectedDatabase": "decoded URL database name; exact runtime current_database match",
    "batchIdAuthority": "U04 import receipt, not an entity-map authority",
    "requiredRoles": "Fresh LOGIN runtime role; nonowner/nonsuper/no create/no SET owner; target DB owner remains NOLOGIN",
    "platformRules": [
      "AUTO_CREATE_DATABASE=false",
      "BOOTSTRAP_ADMIN_USERNAME and BOOTSTRAP_ADMIN_PASSWORD absent",
      "Explicit fresh strong JWT_SECRET required even in development",
      "Successful imported proof skips migrations/seed/region_seed before HTTP/workers"
    ]
  },
  "nonMappingReferenceRules": [
    {
      "kind": "artifact-manifest-schema1",
      "uuidFields": [],
      "operation": "Validate closed schema and preserve immutable original bytes"
    },
    {
      "kind": "deployment-policy",
      "uuidFields": [],
      "operation": "Logical target/group/node/template/applicationCode fields stay opaque; do not rewrite ID-shaped text"
    },
    {
      "kind": "work-order-deep-link",
      "template": "/micro/work-orders/tickets/{ticketId}",
      "authority": "work_orders.ticket",
      "operation": "Exact owner route parser only"
    },
