{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit platform application access policy change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "id",
    "allowedMemberTypes",
    "accessPolicyVersion",
    "reason"
  ],
  "properties": {
    "target": {
      "const": "application"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-7[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
    },
    "allowedMemberTypes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": [
          "EMPLOYEE",
          "CUSTOMER"
        ]
      },
      "minItems": 1
    },
    "accessPolicyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "Trimmed reason must contain 1 to 500 Unicode characters; the CLI enforces the trimmed length.",
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    }
  }
}
