# Operator template only. Copy outside the checkout, restrict access (0600),
# then replace every placeholder. No value here is a production credential.
PUBLIC_APP_URL=https://platform.example.invalid
EDGE_NETWORK_NAME=platform-edge
# Candidate: create a non-conflicting private bridge subnet 172.30.0.0/24.
# This exact IP must belong to it; backend TRUSTED_PROXY_IPS uses the same value.
GATEWAY_PRIVATE_IP=172.30.0.10
HTTP_PORT=80
HTTPS_PORT=443

# Set approved registry/repository@sha256:<64-hex> values; do not use mutable tags.
POSTGRES_IMAGE=
PLATFORM_IMAGE=
FRONTEND_IMAGE=
GATEWAY_IMAGE=
POSTGRES_USER=platform
POSTGRES_DB=saas_platform
POSTGRES_PASSWORD=
PLATFORM_DATABASE_URL=
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=5000
APP_AUTHORIZATION_TIMEOUT_MS=5000
APP_AUTHORIZATION_MAX_CONCURRENT=32
JWT_SECRET=
PLATFORM_METRICS_TOKEN=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Server-owned data-grant capability and management allowlists; empty denies.
# Keep the outer single quotes: Compose env-file and POSIX shells preserve JSON.
DATA_GRANT_POLICY='{"applications":[],"managementScopes":[]}'

# Existing Linux files, readable by container UID/GID 101; never baked into images.
GATEWAY_CONFIG_FILE=/srv/platform/config/nginx.conf
TLS_CERTIFICATE_FILE=/srv/platform/secrets/fullchain.pem
TLS_PRIVATE_KEY_FILE=/srv/platform/secrets/privkey.pem

# Optional standalone micro-static image and version store; the base Compose does not mount them.
MICRO_STATIC_IMAGE=
MICRO_STATIC_CONFIG_FILE=/srv/platform/config/micro-static.conf
MICRO_APPS_DIR=/srv/platform/micro-apps
