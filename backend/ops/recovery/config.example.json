{
  "profile": "pilot",
  "service_file": "/etc/saas/recovery/pg-services.conf",
  "databases": [
    {
      "kind": "platform",
      "source_service": "platform"
    },
    {
      "kind": "work_orders",
      "source_service": "work_orders"
    },
    {
      "kind": "stores",
      "source_service": "stores"
    }
  ],
  "key_file": "/run/saas-recovery-key/master",
  "scratch": "/run/saas-recovery-scratch",
  "local_bundle": "/var/lib/saas-recovery/set.enc",
  "artifact_root": "/var/lib/saas-recovery/materialized-inputs",
  "remote_url": "https://backup.example.invalid/objects/saas",
  "remote_token_file": "/etc/saas/recovery/object-token",
  "ca_file": "/etc/saas/recovery/private-ca.pem",
  "monitor_url": "https://monitor.example.invalid/internal/events",
  "monitor_token_file": "/etc/saas/recovery/monitor-token",
  "sequence_file": "/var/lib/saas-recovery/events.sequence",
  "timeout_seconds": 1800
}
