# Operator-owned, mode 0600, outside the checkout. Merge after platform.env.
# All six values require an approved real registry digest, never only a tag.
WORK_ORDERS_API_IMAGE=
WORK_ORDERS_V1_IMAGE=
WORK_ORDERS_V2_IMAGE=
STORES_API_IMAGE=
STORES_V1_IMAGE=
STORES_V2_IMAGE=

# Distinct business databases/accounts; neither service reads platform tables.
WORK_ORDERS_DATABASE_URL=
STORES_DATABASE_URL=
WORK_ORDERS_PLATFORM_CLIENT_ID=
WORK_ORDERS_PLATFORM_CLIENT_SECRET=
STORES_PLATFORM_CLIENT_ID=
STORES_PLATFORM_CLIENT_SECRET=
WORK_ORDERS_PLATFORM_AUTHORIZATION_MODE=combined
STORES_PLATFORM_AUTHORIZATION_MODE=legacy
WORK_ORDERS_METRICS_TOKEN=
STORES_METRICS_TOKEN=

# Only compose.business-ca.yml needs this optional public CA chain (no key).
BUSINESS_PLATFORM_CA_FILE=/srv/platform/config/public-platform-ca.pem
