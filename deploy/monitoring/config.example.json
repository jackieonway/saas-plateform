{
  "environment": "production",
  "intervalMs": 5000,
  "timeoutMs": 2000,
  "downThreshold": 2,
  "recoveryThreshold": 2,
  "maxResponseBytes": 1048576,
  "eventLog": "/var/lib/rust-saas/monitor/alerts.jsonl",
  "targets": [
    { "name": "platform-health", "kind": "health", "url": "https://saas.example.test/api/health" },
    { "name": "work-orders-health", "kind": "health", "url": "https://saas.example.test/work-orders-api/health" },
    { "name": "notification-health", "kind": "health", "url": "https://saas.example.test/notification-health" },
    { "name": "platform-metrics", "kind": "prometheus", "private": true, "url": "http://127.0.0.1:3001/api/internal/metrics", "tokenEnv": "PLATFORM_METRICS_TOKEN" },
    { "name": "work-orders-metrics", "kind": "prometheus", "private": true, "url": "http://127.0.0.1:3004/work-orders-api/metrics", "tokenEnv": "WORK_ORDERS_METRICS_TOKEN" },
    { "name": "notification-metrics", "kind": "prometheus", "private": true, "url": "http://127.0.0.1:3003/metrics", "tokenEnv": "NOTIFICATION_METRICS_TOKEN" },
    { "name": "work-orders-release", "kind": "asset", "url": "https://saas.example.test/sub-apps/work-orders/versions/1.0.0/assets/config.js", "contains": "\"version\":\"1.0.0\"" }
  ]
}
