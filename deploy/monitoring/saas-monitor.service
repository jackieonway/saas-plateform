[Unit]
Description=Rust SaaS local HTTPS health and private metrics monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rust-saas
Group=rust-saas
EnvironmentFile=/etc/rust-saas/monitor.env
ExecStart=/opt/rust-saas/node/bin/node /opt/rust-saas/deploy/monitoring/monitor.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rust-saas/monitor
UMask=0077
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
