# Compose production entry. PUBLIC_APP_URL must be an exact HTTPS origin;
# Caddy provisions normal public certificates. Use native/render.mjs for a
# supplied certificate/private CA. Certificate state persists in /data.
{
    admin off
    log {
        level WARN
    }
}
{$PUBLIC_APP_URL} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' {$PUBLIC_APP_URL} {$MICRO_TRUSTED_SCRIPT_ORIGINS}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' {$PUBLIC_APP_URL} {$PUBLIC_SOCKET_ORIGIN} {$MICRO_FRAME_ORIGINS}; frame-src 'self' {$MICRO_FRAME_ORIGINS}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        -Server
    }
    @private path /api/internal/* /metrics /work-orders-api/metrics
    handle @private {
        respond 404
    }
    @platform path /api/* /oauth/*
    handle @platform {
        reverse_proxy backend:3001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    handle /notification-health {
        rewrite * /health
        reverse_proxy notification-ws:3003 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    handle /socket.io/* {
        reverse_proxy notification-ws:3003 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    @business path /work-orders-api /work-orders-api/*
    handle @business {
        reverse_proxy work-orders-api:3004 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
        }
    }
    handle_path /sub-apps/* {
        @versioned path_regexp version ^/[a-z0-9-]+/versions/[A-Za-z0-9._-]+/
        handle @versioned {
            root * /micro-apps
            header Cache-Control "no-cache"
            header Access-Control-Allow-Origin "*"
            @module path *.mjs *.cjs
            header @module Content-Type "application/javascript"
            @immutable {
                path_regexp file ^/[a-z0-9-]+/versions/[A-Za-z0-9._-]+/.*[^/]$
                not path_regexp html (?i)\.html?$
            }
            header @immutable Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            root * /srv/sub-apps
            header Cache-Control "no-cache"
            file_server
        }
    }
    handle /assets/* {
        root * /srv
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
    handle_errors {
        header Cache-Control "no-store"
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
