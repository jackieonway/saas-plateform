# Merge the base platform env and this operator-owned restricted env file.
# docker compose --env-file /secure/platform.env --env-file /secure/notification.env \
#   -f docker-compose.yml -f deploy/compose.notification.yml --profile notification config --quiet
# Repeat the identical files/profile with up -d only after reviewing the target.
# No image is built or pushed during deployment. Mutable tags, including latest,
# are not approved release identities: supply repository@sha256:<64-hex>.
NOTIFICATION_IMAGE=
NOTIFICATION_DATABASE_URL=
NOTIFICATION_METRICS_TOKEN=
# Exact HTTPS origins only; default is PUBLIC_APP_URL from the base env.
# NOTIFICATION_ALLOWED_ORIGINS=https://platform.example.invalid
# The bounded Rust defaults can be changed explicitly after measuring capacity.
NOTIFICATION_AUTH_TIMEOUT_MS=2000
NOTIFICATION_AUTH_RECHECK_MS=30000
NOTIFICATION_AUTH_WAIT_MS=10000
NOTIFICATION_HEALTH_PROBE_MS=5000
NOTIFICATION_DATABASE_RETRY_MS=1000
NOTIFICATION_MAX_CONNECTIONS=256
NOTIFICATION_MAX_PARTITIONS=128
NOTIFICATION_PER_PARTITION_QUEUE=32
NOTIFICATION_TOTAL_QUEUE=1000
NOTIFICATION_MAX_INFLIGHT=8
NOTIFICATION_VALIDATION_CONCURRENCY=16

# The public gateway JSON must allow notification-ws and set
# "notification": "notification-ws:3003". The private service publishes no host
# port. Health probes and metrics stay private; metrics require their own Bearer.
# This file deliberately contains no platform signing key or privileged DB URL.
# Provision notification_ws with notification-role.sql before enabling the service.
