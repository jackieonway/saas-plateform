# Optional CI packaging of a separately locked, source-bound Linux ELF. The
# candidate report records this mode; it is not a Docker source-build result.
ARG RUNTIME_IMAGE=debian:bookworm-slim
FROM ${RUNTIME_IMAGE}
ARG APP_CODE
ARG API_PORT
ARG SOURCE_REVISION
ARG INPUTS_SHA256
ARG BUILD_ID
LABEL org.opencontainers.image.title="${APP_CODE} verified Rust API ELF" \
    org.opencontainers.image.revision="${SOURCE_REVISION}" \
    saas.application="${APP_CODE}" \
    saas.ci.inputs-sha256="${INPUTS_SHA256}" \
    saas.build-id="${BUILD_ID}"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 business \
    && useradd --system --uid 10001 --gid business --no-create-home business
COPY --chown=10001:10001 business-api /usr/local/bin/business-api
ENV NODE_ENV=production WORK_ORDERS_HOST=0.0.0.0 WORK_ORDERS_PORT=3004 STORES_HOST=0.0.0.0 STORES_PORT=3031 TZ=Asia/Shanghai RUST_LOG=info
ENV API_HEALTH_URL="http://127.0.0.1:${API_PORT}/${APP_CODE}-api/health/ready"
USER 10001:10001
EXPOSE ${API_PORT}
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=5s --timeout=4s --start-period=30s --retries=3 \
    CMD curl --fail --silent --max-time 3 "$API_HEALTH_URL" > /dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/business-api"]
