types {
    text/html html htm;
    text/css css;
    application/javascript js mjs cjs;
    application/json json map;
    application/wasm wasm;
    text/plain txt;
    image/svg+xml svg svgz;
    image/png png;
    image/jpeg jpg jpeg;
    image/gif gif;
    image/webp webp;
    image/avif avif;
    image/x-icon ico;
    font/woff woff;
    font/woff2 woff2;
    font/ttf ttf;
    font/otf otf;
    application/octet-stream bin;
    application/pdf pdf;
    audio/mpeg mp3;
    video/mp4 mp4;
}
