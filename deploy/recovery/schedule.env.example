# Root-owned regular 0600 file. List ALL writers, including externally started jobs.
# Services previously inactive are left inactive. No retention deletion is performed.
# Match actual deployment unit names. Order is the restart dependency order.
BACKUP_ENV_FILE=/etc/saas/recovery/backup.env
BACKUP_WRITE_UNITS=saas-platform.service,saas-work-orders.service,saas-notifications.service
