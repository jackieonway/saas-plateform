# Copy outside the checkout and backup store; chmod 0600; Linux Node 24 required.
# Generate a 32-byte binary key: umask 077; openssl rand -out /secure/backup.key 32
# Escrow the key separately. Loss of the key prevents recovery.
BACKUP_KEY_FILE=/secure/backup.key
PG_DUMP_BIN=/usr/lib/postgresql/17/bin/pg_dump
PG_RESTORE_BIN=/usr/lib/postgresql/17/bin/pg_restore
PSQL_BIN=/usr/lib/postgresql/17/bin/psql
# Optional for the pinned locally extracted client. System clients do not need it.
# PG_CLIENT_LIBRARY_PATH=/opt/saas/postgres-client/root/usr/lib/x86_64-linux-gnu

# backup subcommand only. Distinct databases, read-complete dump privileges.
BACKUP_PLATFORM_DATABASE_URL=postgresql://backup_operator:REPLACE_ME@platform-db:5432/platform?sslmode=verify-full&sslrootcert=/secure/postgres-ca.pem
BACKUP_WORK_ORDERS_DATABASE_URL=postgresql://backup_operator:REPLACE_ME@business-db:5432/work_orders?sslmode=verify-full&sslrootcert=/secure/postgres-ca.pem
BACKUP_ROOT=/var/lib/saas-backups
# Set only after all platform/business/notification writers have stopped.
BACKUP_WRITES_QUIESCED=true

# restore subcommand only. Maintenance roles need CREATE DATABASE permission.
# Target databases MUST NOT already exist. Passwords/hosts are never CLI args.
RESTORE_PLATFORM_MAINTENANCE_URL=postgresql://restore_operator:REPLACE_ME@restore-db:5432/postgres?sslmode=verify-full&sslrootcert=/secure/postgres-ca.pem
RESTORE_WORK_ORDERS_MAINTENANCE_URL=postgresql://restore_operator:REPLACE_ME@restore-db:5432/postgres?sslmode=verify-full&sslrootcert=/secure/postgres-ca.pem
RESTORE_PLATFORM_DATABASE=saas_restore_platform_20261007
RESTORE_WORK_ORDERS_DATABASE=saas_restore_work_orders_20261007
