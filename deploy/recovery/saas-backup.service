[Unit]
Description=SaaS authenticated encrypted PostgreSQL backup with a stopped-write window
After=network-online.target
Wants=network-online.target
# Connect this to the deployment's local alert handler; never place secrets in the alert.
OnFailure=saas-operations-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/saas/runtime/node/bin/node /opt/saas/current/deploy/recovery/scheduled-backup.mjs --schedule-file /etc/saas/recovery/schedule.env
TimeoutStartSec=35min
TimeoutStopSec=5min
# Allow the wrapper to restart writers after a stop, even if systemd requests termination.
KillSignal=SIGTERM
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/saas-backups

[Install]
WantedBy=multi-user.target
