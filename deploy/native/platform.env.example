# Store the populated file outside Git at /srv/dante/secrets/platform.env.
# chmod 0600 and assign to the dedicated service identity. OS environment wins.
APP_ENV=production
APPLICATION_ENVIRONMENT=production
DATABASE_URL=
AUTO_CREATE_DATABASE=false
BIND_ADDR=127.0.0.1:3001
JWT_SECRET=
METRICS_TOKEN=
PUBLIC_APP_URL=https://saas.example.com
MICRO_GATEWAY_ORIGIN=https://saas.example.com
MICRO_ALLOWED_ORIGINS=https://saas.example.com
CORS_ALLOWED_ORIGINS=https://saas.example.com
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Only an empty platform database requires an explicit bootstrap administrator.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
OAUTH_INTROSPECTION_CLIENT_REQUESTS_PER_MINUTE=600
OAUTH_AUTH_FAILURE_REQUESTS_PER_MINUTE=30
OAUTH_AUTO_PURGE=false
# Optional private CA, normal certificate validation is always enabled.
MICRO_CA_CERT_FILE=
RUST_LOG=info
