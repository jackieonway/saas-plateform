{
  "name": "notification-ws",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node test drivers for the standalone Rust notification service",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/rust-platform-e2e.mjs tests/rust-scheduler.mjs tests/rust-boundaries.mjs tests/rust-auth-races.mjs",
    "test:unit": "cargo test --locked",
    "test:integration": "node --test --test-concurrency=1 tests/rust-platform-e2e.mjs tests/rust-scheduler.mjs tests/rust-boundaries.mjs tests/rust-auth-races.mjs",
    "test:browser": "node --test tests/rust-browser.mjs"
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "pg": "^8.16.3",
    "socket.io-client": "^4.8.4"
  }
}
