# Copy into an ignored .env file, replace placeholders, and provide it at startup.
DATABASE_URL=postgresql://notification_ws:REPLACE_PASSWORD@postgres:5432/saas_platform
NOTIFICATION_ENV=production
PLATFORM_API_BASE_URL=https://saas.example.com
METRICS_TOKEN=
# Local acceptance CA only, using normal TLS verification. Set an actual PEM path when needed.
# NOTIFICATION_PLATFORM_CA_FILE=/etc/rust-saas/platform-ca.pem
NOTIFICATION_ALLOWED_ORIGINS=https://saas.example.com
NOTIFICATION_HOST=0.0.0.0
NOTIFICATION_PORT=3003
NOTIFICATION_SOCKET_PATH=/socket.io/
NOTIFICATION_AUTH_TIMEOUT_MS=2000
NOTIFICATION_AUTH_RECHECK_MS=30000
NOTIFICATION_AUTH_WAIT_MS=10000
NOTIFICATION_HEALTH_PROBE_MS=5000
NOTIFICATION_DATABASE_RETRY_MS=1000
# Every in-memory limit is bounded; dropped hints remain in the HTTP inbox.
NOTIFICATION_MAX_CONNECTIONS=256
NOTIFICATION_MAX_PARTITIONS=128
NOTIFICATION_PER_PARTITION_QUEUE=32
NOTIFICATION_TOTAL_QUEUE=1000
NOTIFICATION_MAX_INFLIGHT=8
NOTIFICATION_VALIDATION_CONCURRENCY=16
