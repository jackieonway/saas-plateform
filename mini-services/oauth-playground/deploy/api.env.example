# Private runtime-only configuration. Never pass these values as Vite build args
# or VITE_* variables. No automatic .env loading is performed by the Rust API.
OAUTH_PUBLIC_ORIGIN=https://oauth.example.invalid
OAUTH_PLATFORM_ORIGIN=https://platform.example.invalid
OAUTH_ALLOW_INSECURE_LOOPBACK=false
OAUTH_AUTH_CLIENT_ID=REPLACE_WITH_REGISTERED_PKCE_CLIENT_ID
# This rehearsal supports confidential authorization clients with PKCE.
OAUTH_AUTH_CLIENT_SECRET=REPLACE_WITH_PRIVATE_AUTH_CLIENT_SECRET
OAUTH_DEVICE_CLIENT_ID=REPLACE_WITH_REGISTERED_DEVICE_CLIENT_ID
OAUTH_DEVICE_CLIENT_SECRET=
OAUTH_CC_CLIENT_ID=REPLACE_WITH_REGISTERED_MACHINE_CLIENT_ID
OAUTH_CC_CLIENT_SECRET=REPLACE_WITH_PRIVATE_MACHINE_CLIENT_SECRET
OAUTH_PASSWORD_ENABLED=false
OAUTH_PASSWORD_CLIENT_ID=
OAUTH_PASSWORD_CLIENT_SECRET=
OAUTH_SCOPE=profile

