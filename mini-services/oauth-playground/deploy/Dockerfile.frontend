# syntax=docker/dockerfile:1
# Context: mini-services/oauth-playground. Build tools never enter runtime.
ARG NODE_IMAGE=node:24.18.0-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28.0-alpine
FROM ${NODE_IMAGE} AS build
WORKDIR /app
RUN npm install --global npm@11.16.0
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
ARG SOURCE_REVISION
RUN echo "$SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$' && npm run build

FROM ${NGINX_IMAGE} AS runtime
ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="OAuth rehearsal static frontend" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
USER 101:101
COPY --from=build --chown=101:101 /app/dist/ /usr/share/nginx/html/
COPY --chown=101:101 deploy/static.nginx.conf /etc/nginx/nginx.conf
EXPOSE 8080
STOPSIGNAL SIGQUIT
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]

