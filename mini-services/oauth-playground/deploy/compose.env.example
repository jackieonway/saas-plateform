# Operator-owned Linux paths and immutable approved image digests only.
# Keep outside the source checkout; replace all placeholders.
OAUTH_API_IMAGE=registry.example.invalid/oauth-api@sha256:REPLACE_WITH_APPROVED_DIGEST
OAUTH_FRONTEND_IMAGE=registry.example.invalid/oauth-web@sha256:REPLACE_WITH_APPROVED_DIGEST
OAUTH_EDGE_IMAGE=nginxinc/nginx-unprivileged@sha256:REPLACE_WITH_APPROVED_DIGEST
OAUTH_API_ENV_FILE=/srv/oauth/secrets/api.env
OAUTH_EDGE_CONFIG_FILE=/srv/oauth/config/nginx.conf
OAUTH_TLS_CERTIFICATE_FILE=/srv/oauth/secrets/fullchain.pem
OAUTH_TLS_PRIVATE_KEY_FILE=/srv/oauth/secrets/privkey.pem
OAUTH_HTTP_PORT=80
OAUTH_HTTPS_PORT=443

