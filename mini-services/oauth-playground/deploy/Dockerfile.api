# syntax=docker/dockerfile:1
# Context: mini-services/oauth-playground. No frontend or private env copied.
ARG RUST_IMAGE=rust:1.97.0-slim-bookworm
ARG RUNTIME_IMAGE=debian:12.13-slim
FROM ${RUST_IMAGE} AS build
WORKDIR /app
ARG CARGO_BUILD_JOBS=2
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/src/ ./src/
ARG SOURCE_REVISION
RUN echo "$SOURCE_REVISION" | grep -Eq '^[0-9a-f]{40}$' && cargo build --release --locked

FROM ${RUNTIME_IMAGE} AS runtime
ARG SOURCE_REVISION
LABEL org.opencontainers.image.title="OAuth rehearsal Rust flow API" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 oauth \
    && useradd --system --uid 10001 --gid oauth --no-create-home oauth
COPY --from=build /app/target/release/oauth-playground-api /usr/local/bin/oauth-playground-api
ENV OAUTH_BIND_ADDR=0.0.0.0:3011 RUST_LOG=info
USER 10001:10001
EXPOSE 3011
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:3011/health > /dev/null || exit 1
ENTRYPOINT ["oauth-playground-api"]

